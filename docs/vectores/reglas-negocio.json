{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descripcion": "Reglas de negocio canónicas extraídas de Shalev Android para validación e integridad en iOS y DShalev",
  "dinero": {
    "moneda": "CUP",
    "unidadInterna": "centavos",
    "tipoDato": "entero",
    "centavosPorPeso": 100,
    "modoRedondeo": "HALF_UP",
    "puntosBasicosPorPorciento": 100,
    "formatoPantalla": "#,##0.## CUP",
    "separadorMilesPantalla": "\u202F",
    "formatoExport": "#,##0.## CUP",
    "patronEntrada": "^-?[0-9]{1,3}(,[0-9]{3})*(\\.[0-9]{1,2})?$|^-?[0-9]+(\\.[0-9]{1,2})?$"
  },
  "carneCubano": {
    "longitud": 11,
    "tipo": "solo_digitos",
    "estructura": "AAMMDD + siglo + consecutivo",
    "siglos": {
      "9": 1800,
      "0": 1900,
      "1": 1900,
      "2": 1900,
      "3": 1900,
      "4": 1900,
      "5": 1900,
      "6": 2000,
      "7": 2000,
      "8": 2000
    },
    "validaFechaCalendario": true,
    "rechazaFechaFutura": true
  },
  "telefonoMovilCubano": {
    "paisPrefijo": "+53",
    "longitudE164": 11,
    "seriesValidas": ["5", "6"],
    "permiteFijos": false,
    "ejemplosValidos": ["+5351815604", "+5363123456", "51815604", "63123456"]
  },
  "nombres": {
    "longitudMinima": 2,
    "longitudMaxima": 80,
    "patron": "^\\p{L}[\\p{L} '\\-]{0,78}\\p{L}$",
    "permiteEspaciosInternos": true,
    "permiteApostrofo": true,
    "permiteGuion": true
  },
  "stock": {
    "producto": {
      "unidad": "entera",
      "fraccionable": false
    },
    "insumo": {
      "unidad": "decimal",
      "precisionDecimales": 3,
      "factorConversionMil": 1000,
      "fraccionable": true
    }
  },
  "turnoYCaja": {
    "exigeTurnoAbierto": true,
    "mensajeVentaSinTurno": "No se vende sin turno abierto",
    "metodosPago": ["EFECTIVO", "TRANSFERENCIA"],
    "requiereArqueoCierre": true
  },
  "tarjetasCubanas": {
    "longitud": 16,
    "prefijoObligatorio": "9",
    "algoritmoLuhn": true,
    "redesConocidas": {
      "92": "RED",
      "95": "AIS",
      "97": "Clásica"
    }
  }
}
