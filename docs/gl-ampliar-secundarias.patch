+    @Test
+    fun sellarAbrirAmpliacionYRechazarCombinacionInvalida() {
+        val gl = CryptoEngine.generateEphemeralP256()
+        val valida = dto().copy(secundarias = 5, amplia = "lic-previa-01")
+        val codigo = Spvi23.sellarSolicitud(valida, gl.public)
+        val abierto = Spvi23.abrir(codigo, gl.private)
+        assertThat((abierto as Outcome.Ok).value).isEqualTo(valida)
+
+        val simultanea = dto().copy(secundarias = 5, renueva = "lic-previa-01", amplia = "lic-previa-01")
+        val codigoSimultanea = Spvi23.sellarSolicitud(simultanea, gl.public)
+        assertThat(Spvi23.abrir(codigoSimultanea, gl.private)).isInstanceOf(Outcome.Err::class.java)
+
+        val ceroSec = dto().copy(secundarias = 0, amplia = "lic-previa-01")
+        val codigoCero = Spvi23.sellarSolicitud(ceroSec, gl.public)
+        assertThat(Spvi23.abrir(codigoCero, gl.private)).isInstanceOf(Outcome.Err::class.java)
+    }
 }
