@@ -168,4 +168,57 @@ class RenovacionSpviTest {
 
         assertThat(result.value.licencia.txNumber).isEqualTo("TX-SPVI")
     }
+
+    @Test
+    fun ampliacionConservaVencimientoYCobraSoloSecundariasAdicionales() = runTest {
+        val licencias = MemLic()
+        val venceOriginal = ahoraSec + 12 * 86_400L
+        licencias.upsert(anterior("previa", venceSec = venceOriginal))
+
+        val r = emitir(sol().copy(secundarias = 5, amplia = "previa"), licencias) as Outcome.Ok
+
+        assertThat(r.value.licencia.secundarias).isEqualTo(5)
+        assertThat(r.value.licencia.expiresAtIso).isEqualTo(Instant.ofEpochSecond(venceOriginal).toString())
+        assertThat(r.value.licencia.precioCobrado).isEqualTo(3_000)
+    }
+
+    @Test
+    fun ampliacionDePerpetuaConservaEstadoPerpetuoYCobraTarifaPerpetua() = runTest {
+        val licencias = MemLic()
+        licencias.upsert(
+            anterior("perp", venceSec = ahoraSec + 86_400L).copy(
+                type = TipoLicencia.PERPETUA,
+                status = EstadoLicencia.PERPETUA,
+                expiresAtIso = null,
+                secundarias = 1,
+                precioCobrado = 107_000,
+            ),
+        )
+
+        val r = emitir(
+            sol().copy(tipo = TipoLicencia.PERPETUA, secundarias = 3, amplia = "perp"),
+            licencias,
+        ) as Outcome.Ok
+
+        assertThat(r.value.licencia.status).isEqualTo(EstadoLicencia.PERPETUA)
+        assertThat(r.value.licencia.expiresAtIso).isNull()
+        assertThat(r.value.licencia.secundarias).isEqualTo(3)
+        assertThat(r.value.licencia.precioCobrado).isEqualTo(34_000)
+    }
+
+    @Test
+    fun ampliacionRechazaLicenciaVencidaAjenaOSinIncremento() = runTest {
+        val licencias = MemLic()
+        licencias.upsert(anterior("vencida", venceSec = ahoraSec - 60L))
+        licencias.upsert(anterior("ajena", deviceId = "SPVI:otro-99999", venceSec = ahoraSec + 5 * 86_400L))
+        licencias.upsert(anterior("vigente", venceSec = ahoraSec + 5 * 86_400L))
+
+        val rVencida = emitir(sol().copy(secundarias = 4, amplia = "vencida"), licencias) as Outcome.Err
+        val rAjena = emitir(sol().copy(secundarias = 4, amplia = "ajena"), licencias) as Outcome.Err
+        val rIgual = emitir(sol().copy(secundarias = 2, amplia = "vigente"), licencias) as Outcome.Err
+
+        assertThat(rVencida.error).isEqualTo(AppError.AmpliacionInvalida)
+        assertThat(rAjena.error).isEqualTo(AppError.AmpliacionInvalida)
+        assertThat(rIgual.error).isEqualTo(AppError.AmpliacionInvalida)
+    }
