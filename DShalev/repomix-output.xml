  <a href="/equipo" class="nav-link {% if section == 'equipo' %}active{% endif %}" {% if section == 'equipo' %}aria-current="page"{% endif %}><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M 12 12 c 2.21 0 4 -1.79 4 -4 s -1.79 -4 -4 -4 -4 1.79 -4 4 1.79 4 4 4 z m 0 2 c -2.67 0 -8 1.34 -8 4 v 2 h 16 v -2 c 0 -2.66 -5.33 -4 -8 -4 z"/></svg></span>Equipo</a>
  <a href="/red" class="nav-link {% if section == 'red' %}active{% endif %}" {% if section == 'red' %}aria-current="page"{% endif %}><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="m1 9 2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8 3 3 3-3a4.237 4.237 0 0 0-6 0zm-4-4 2 2a7.074 7.074 0 0 1 10 0l2-2C15.14 9.14 8.87 9.14 5 13z"/></svg></span>Acceso</a>
  {% if user.role == 'admin' %}<a href="/respaldo" class="nav-link {% if section == 'respaldo' %}active{% endif %}" {% if section == 'respaldo' %}aria-current="page"{% endif %}><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M 19.35 10.04 A 7.49 7.49 0 0 0 12 4 C 9.11 4 6.6 5.64 5.35 8.04 A 5.994 5.994 0 0 0 0 14 c 0 3.31 2.69 6 6 6 h 13 c 2.76 0 5 -2.24 5 -5 0 -2.64 -2.05 -4.78 -4.65 -4.96 z M 14 13 v 4 h -4 v -4 H 7 l 5 -5 5 5 h -3 z"/></svg></span>Respaldo</a>{% endif %}
  <a href="/licencia" class="nav-link {% if section == 'licencia' %}active{% endif %}" {% if section == 'licencia' %}aria-current="page"{% endif %}><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M 21 10 h -8.35 A 5.99 5.99 0 0 0 7 6 c -3.31 0 -6 2.69 -6 6 s 2.69 6 6 6 a 5.99 5.99 0 0 0 5.65 -4 H 13 l 2 2 2 -2 2 2 4 -4.04 L 21 10 z M 7 15 c -1.65 0 -3 -1.35 -3 -3 s 1.35 -3 3 -3 3 1.35 3 3 -1.35 3 -3 3 z"/></svg></span>Licencia</a>
  <div class="rail-footer">DShalev · 0.1</div>
</nav>
<main class="main-shell">
  {% if notice %}<div class="notice {{ notice_kind or 'info' }}" role="status">{{ notice }}</div>{% endif %}
  {% block content %}{% endblock %}
</main>
{% else %}<p class="tiny">Local: {{ local_id or "original" }}</p>{% block public_content %}{% endblock %}{% endif %}
</body></html>
</file>

<file path="dshalev/templates/cost_line_edit.html">
{% extends 'base.html' %}{% block title %}Editar partida{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">FICHA DE COSTO</p><h1>Editar partida</h1></div><a class="secondary-button" href="/herramientas/fichas/{{ line.sheet_id }}">Volver a la ficha</a></div>
<section class="panel"><form method="post" action="/herramientas/fichas/{{ line.sheet_id }}/partidas/{{ line.id }}/editar" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Descripción<input name="description" maxlength="80" value="{{ line.description }}" required></label><label>Categoría<select name="category">{% for key,label in categories.items() %}<option value="{{ key }}" {% if line.category == key %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><div class="form-row"><label>Cantidad<input name="quantity" inputmode="decimal" value="{{ line.quantity }}" required></label><label>Unidad<input name="unit" maxlength="20" value="{{ line.unit }}" required></label></div><div class="form-row"><label>Costo unitario<input name="unit_cost" inputmode="decimal" value="{{ line.unit_cost }}" required></label><label>Moneda<select name="currency">{% for currency in currencies %}<option value="{{ currency }}" {% if currency == line.currency %}selected{% endif %}>{{ currency }}</option>{% endfor %}</select></label></div><button class="primary-button">Guardar cambios</button></form></section>
{% endblock %}
</file>

<file path="dshalev/templates/cost_sheet.html">
{% extends 'base.html' %}{% block title %}Ficha de costo{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">FICHA DE COSTO</p><h1>{{ sheet.name }}</h1><p class="muted">Calcula cada moneda por separado. El catálogo solo cambia al confirmar una exportación.</p></div><div class="heading-actions"><a class="secondary-button" href="/herramientas/fichas/{{ sheet.id }}/exportar.xlsx">Exportar Excel</a><a class="secondary-button" href="/herramientas/fichas">Todas las fichas</a></div></div>
<div class="content-grid"><section class="panel"><h2>Datos y margen</h2><form method="post" action="/herramientas/fichas/{{ sheet.id }}/ajustes" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Nombre<input name="name" value="{{ sheet.name }}" maxlength="80" required></label><div class="form-row"><label>Margen (opcional)<input name="margin" inputmode="decimal" value="{{ sheet.margin }}" placeholder="Sin margen"></label><label>Unidad<select name="margin_unit"><option value="PORCENTAJE" {% if sheet.margin_unit == 'PORCENTAJE' %}selected{% endif %}>Porcentaje sobre costo</option><option value="FACTOR" {% if sheet.margin_unit == 'FACTOR' %}selected{% endif %}>Factor del costo</option></select></label></div><button class="secondary-button">Guardar cambios</button></form></section>
<section class="panel"><h2>Agregar partida</h2><form method="post" action="/herramientas/fichas/{{ sheet.id }}/partidas" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Descripción<input name="description" maxlength="80" required></label><label>Categoría<select name="category">{% for key,label in categories.items() %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></label><div class="form-row"><label>Cantidad<input name="quantity" inputmode="decimal" required></label><label>Unidad<input name="unit" maxlength="20" value="unidad" required></label></div><div class="form-row"><label>Costo unitario<input name="unit_cost" inputmode="decimal" required></label><label>Moneda<select name="currency"><option>CUP</option><option>USD</option></select></label></div><button class="primary-button">Agregar partida</button></form></section></div>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">DESGLOSE</p><h2>Partidas</h2></div></div>{% if totals.lines %}<div class="table-wrap"><table><thead><tr><th>Descripción</th><th>Categoría</th><th>Cantidad</th><th class="numeric">Costo unitario</th><th class="numeric">Subtotal</th><th>Acción</th></tr></thead><tbody>{% for line in totals.lines %}<tr><td>{{ line.description }}</td><td>{{ categories[line.category] }}</td><td>{{ line.quantity }} {{ line.unit }}</td><td class="numeric">{{ line.unit_cost }} {{ line.currency }}</td><td class="numeric">{{ line.subtotal }} {{ line.currency }}</td><td><a class="text-link" href="/herramientas/fichas/{{ sheet.id }}/partidas/{{ line.id }}/editar">Editar</a><details><summary>Retirar</summary><form method="post" action="/herramientas/fichas/{{ sheet.id }}/partidas/{{ line.id }}/eliminar"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="quiet-button">Confirmar retiro</button></form></details></td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="muted">Agrega partidas para calcular la ficha.</p>{% endif %}</section>
<section class="panel space-top"><h2>Resumen por categoría</h2><div class="table-wrap"><table><thead><tr><th>Categoría</th><th class="numeric">CUP</th><th class="numeric">USD</th></tr></thead><tbody>{% for key,label in categories.items() %}<tr><td>{{ label }}</td><td class="numeric">{{ totals.categories[key]['CUP'] }}</td><td class="numeric">{{ totals.categories[key]['USD'] }}</td></tr>{% endfor %}<tr><td><strong>Costo total</strong></td><td class="numeric"><strong>{{ totals.totals['CUP'] }}</strong></td><td class="numeric"><strong>{{ totals.totals['USD'] }}</strong></td></tr>{% if totals.prices is not none %}<tr><td><strong>Precio estimado</strong></td><td class="numeric"><strong>{{ totals.prices['CUP'] }}</strong></td><td class="numeric"><strong>{{ totals.prices['USD'] }}</strong></td></tr>{% endif %}</tbody></table></div><p class="tiny">Cada partida se redondea a dos decimales antes de sumar. El margen es orientativo; no se mezclan monedas ni se aplica automáticamente a ventas.</p></section>
<section class="panel space-top"><h2>Exportar al catálogo</h2><p>Se crea un producto o servicio nuevo con una receta a partir de las partidas de materias primas. Se reutilizan insumos activos con el mismo nombre y unidad; los nuevos se crean sin existencias. No se actualizan precios de insumos existentes.</p><p class="tiny">En escritorio, el producto exportado requiere existencias propias además de insumos para venderse. La ficha no se sincroniza como tal con las apps móviles. Una ficha solo puede exportarse una vez a cada tipo mientras el artículo creado permanezca activo.</p><details><summary>Preparar exportación</summary><form method="post" action="/herramientas/fichas/{{ sheet.id }}/exportar-catalogo" class="form-stack space-top"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Destino<select name="category"><option value="Producto">Inventario · producto con receta</option><option value="Servicio">Servicios · servicio con receta</option></select></label><label>Tasa CUP por USD (obligatoria si hay partidas en USD)<input name="rate" inputmode="decimal" placeholder="Ej. 300"></label><button class="primary-button">Confirmar exportación</button></form></details></section>
<section class="panel space-top"><details><summary>Eliminar ficha</summary><p>Se eliminarán también todas sus partidas. Esta acción no se puede deshacer.</p><form method="post" action="/herramientas/fichas/{{ sheet.id }}/eliminar"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="quiet-button">Confirmar eliminación</button></form></details></section>
{% endblock %}
</file>

<file path="dshalev/templates/cost_sheets.html">
{% extends 'base.html' %}{% block title %}Fichas de costo{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">HERRAMIENTAS</p><h1>Fichas de costo</h1><p class="muted">Calcula costos y precios orientativos en CUP y USD por separado.</p></div><a class="secondary-button" href="/herramientas">Volver a herramientas</a></div>
<div class="content-grid"><section class="panel"><h2>Nueva ficha</h2><form method="post" action="/herramientas/fichas/nueva" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Nombre<input name="name" maxlength="80" required></label><button class="primary-button">Crear ficha</button></form></section>
<section class="panel"><h2>Fichas guardadas</h2>{% if sheets %}<div class="employee-list">{% for sheet in sheets %}<div class="employee-row"><div class="employee-info"><strong>{{ sheet.name }}</strong><small>{{ sheet.line_count }} partidas</small></div><a class="text-link" href="/herramientas/fichas/{{ sheet.id }}">Abrir</a></div>{% endfor %}</div>{% else %}<div class="empty-state"><strong>Aún no hay fichas</strong><p>Crea una para comenzar.</p></div>{% endif %}</section></div>
<p class="tiny">Las fichas se guardan en la base cifrada y se incluyen en los respaldos DShalev. No modifican el inventario ni los precios de venta.</p>
{% endblock %}
</file>

<file path="dshalev/templates/customer_edit.html">
{% extends 'base.html' %}{% block title %}Editar cliente{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">DIRECTORIO</p><h1>Editar cliente</h1><p class="muted">Los cambios no alteran ventas anteriores.</p></div><a class="secondary-button" href="/clientes">Volver</a></div>
<section class="panel"><form method="post" action="/clientes/{{ customer.id }}/editar" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Nombre<input name="name" maxlength="100" value="{{ customer.name }}" required></label><div class="form-row"><label>Teléfono<input name="phone" maxlength="40" value="{{ customer.phone }}"></label><label>Correo<input name="email" maxlength="160" type="email" value="{{ customer.email }}"></label></div><label>Notas<textarea name="notes" maxlength="500" rows="3">{{ customer.notes }}</textarea></label><button class="primary-button" type="submit">Guardar cambios</button></form></section>
{% endblock %}
</file>

<file path="dshalev/templates/customers.html">
{% extends 'base.html' %}{% block title %}Clientes{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">RELACIONES Y VENTAS</p><h1>Clientes</h1><p class="muted">Guarda contactos y asocia clientes a las ventas del escritorio.</p></div><a class="quiet-button" href="/clientes.csv">CSV</a><a class="quiet-button" href="/clientes.xlsx">Excel</a></div>
<div class="content-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">ALTA RÁPIDA</p><h2>Nuevo cliente</h2></div><span class="icon-tile">♧</span></div><form method="post" action="/clientes/nuevo" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Nombre<input name="name" maxlength="100" required></label><div class="form-row"><label>Teléfono<input name="phone" maxlength="40" inputmode="tel"></label><label>Correo<input name="email" maxlength="160" type="email"></label></div><label>Notas<textarea name="notes" maxlength="500" rows="3"></textarea></label><button class="primary-button" type="submit">Guardar cliente</button></form></section>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">DIRECTORIO</p><h2>{{ customers|length }} clientes</h2></div></div>{% if customers %}<div class="table-wrap"><table><thead><tr><th>Cliente</th><th>Contacto</th><th>Notas</th><th>Acciones</th></tr></thead><tbody>{% for customer in customers %}<tr><td><strong>{{ customer.name }}</strong></td><td>{{ customer.phone }}{% if customer.email %}<small class="cell-sub">{{ customer.email }}</small>{% endif %}</td><td>{{ customer.notes or '—' }}</td><td><a class="text-link" href="/clientes/{{ customer.id }}/editar">Editar</a><form method="post" action="/clientes/{{ customer.id }}/retirar" class="inline-form"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="quiet-button" type="submit">Retirar</button></form></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><strong>Sin clientes todavía</strong><p>Los clientes son opcionales; las ventas pueden seguir sin asignación.</p></div>{% endif %}</section></div>
{% endblock %}
</file>

<file path="dshalev/templates/dashboard.html">
{% extends 'base.html' %}{% block title %}Inicio{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">RESUMEN DEL NEGOCIO</p><h1>Inicio</h1><p class="muted">Una mirada rápida a la actividad de hoy.</p></div><div class="heading-actions"><a class="primary-button" href="/ventas">＋ Nueva venta</a></div></div>
<div class="metric-grid">
  <article class="metric-card accent"><span class="metric-label">Ventas de hoy</span><strong>{{ today_total }}</strong><span class="metric-foot">{{ today_count }} operaciones</span></article>
  <article class="metric-card"><span class="metric-label">Turno</span><strong class="metric-state {% if shift %}good{% else %}neutral{% endif %}">{% if shift %}Abierto{% else %}Cerrado{% endif %}</strong><span class="metric-foot">{% if shift %}Desde {{ shift.opened_at|replace('T',' ')|truncate(16, True, '') }}{% else %}Sin turno activo{% endif %}</span></article>
  <article class="metric-card"><span class="metric-label">Artículos activos</span><strong>{{ item_count }}</strong><span class="metric-foot">En el inventario</span></article>
  <article class="metric-card {% if low_count %}warning-card{% endif %}"><span class="metric-label">Stock por revisar</span><strong>{{ low_count }}</strong><span class="metric-foot">Bajo o crítico</span></article>
</div>
<section class="content-grid dashboard-insights" aria-label="Estadísticas de ventas">
<article class="panel"><div class="panel-heading"><div><p class="eyebrow">ÚLTIMOS 7 DÍAS</p><h2>Ventas por día</h2></div></div><p class="tiny">Incluye ventas de escritorio y ventas móviles sincronizadas no anuladas.</p><div class="chart-list">{% for day in daily_sales %}<div class="chart-row"><span>{{ day.day[5:] }}</span><progress max="{{ chart_max }}" value="{{ day.total }}" aria-label="Ventas del {{ day.day }}: {{ day.total|cup }}"></progress><strong>{{ day.total|cup }}</strong></div>{% endfor %}</div></article>
<article class="panel"><div class="panel-heading"><div><p class="eyebrow">ÚLTIMOS 7 DÍAS</p><h2>Top 3 artículos</h2></div></div><p class="tiny">Por unidades vendidas en este escritorio, incluidos servicios. No incluye ventas móviles.</p>{% if top_items %}<ol class="ranking">{% for item in top_items %}<li><strong>{{ item.name }}</strong><small>{{ item.quantity }} unidades · {{ item.total|cup }}</small></li>{% endfor %}</ol>{% else %}<div class="empty-state"><strong>Aún no hay ventas en este período</strong><p>Los artículos más vendidos aparecerán aquí.</p></div>{% endif %}</article>
</section>
<section class="content-grid"><article class="panel"><div class="panel-heading"><div><p class="eyebrow">OPERACIÓN</p><h2>Turno de caja</h2></div><span class="status-dot {% if shift %}on{% endif %}"></span></div>
  {% if shift %}<p class="muted">Turno #{{ shift.id }} · Apertura {{ shift.opened_at|replace('T',' ')|truncate(16, True, '') }}</p><p class="metric-foot">Efectivo esperado: <strong>{{ expected_cash }}</strong></p><div class="panel-actions"><a class="secondary-button" href="/ventas">Registrar venta</a><a class="text-link" href="/turnos">Historial →</a></div><form method="post" action="/caja/movimiento" class="form-stack space-top"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="form-row"><label>Movimiento<select name="movement_type"><option value="ENTRADA">Entrada</option><option value="SALIDA">Salida</option></select></label><label>Importe<input name="amount" inputmode="decimal" placeholder="0.00" required></label></div><label>Motivo<input name="reason" maxlength="160" required placeholder="Descripción del movimiento"></label><button class="secondary-button" type="submit">Registrar movimiento</button></form><form method="post" action="/turno/cerrar" class="inline-form space-top"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="compact-label">Efectivo contado <input name="counted_cash" inputmode="decimal" value="" placeholder="{{ expected_cash }}" required></label><button class="quiet-button" type="submit">Cerrar y guardar arqueo</button></form>{% if cash_movements %}<div class="cash-list"><strong class="cell-sub">Movimientos recientes</strong>{% for movement in cash_movements %}<small>{{ movement.movement_type|title }} · {{ movement.amount_cents|cup }} · {{ movement.reason }}</small>{% endfor %}</div>{% endif %}
  {% else %}<p class="muted">Abre un turno para comenzar a registrar ventas.</p><form method="post" action="/turno/abrir" class="inline-form"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="compact-label">Fondo inicial <input name="opening_cash" inputmode="decimal" value="0" required></label><button class="primary-button" type="submit">Abrir turno</button></form><a class="text-link" href="/turnos">Ver historial de turnos →</a>{% endif %}
</article>
<article class="panel"><div class="panel-heading"><div><p class="eyebrow">ACCESO REMOTO</p><h2>Equipo conectado</h2></div><span class="icon-tile">⌁</span></div><p class="muted">El servidor está en modo <strong>{{ network_label }}</strong>. Controla desde qué dispositivos se puede abrir.</p><a class="text-link" href="/red">Configurar acceso →</a></article></section>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">ÚLTIMAS OPERACIONES</p><h2>Ventas recientes</h2></div><a class="text-link" href="/ventas">Ver ventas →</a></div>
{% if sales %}<div class="table-wrap"><table><thead><tr><th>Hora</th><th>Artículos</th><th>Pago</th><th class="numeric">Total</th></tr></thead><tbody>{% for sale in sales %}<tr><td>{{ sale.created_at|replace('T',' ')|truncate(16, True, '') }}</td><td>{{ sale.summary }}</td><td><span class="pill">{{ sale.payment_method|title }}</span></td><td class="numeric amount">{{ sale.total_cents|cup }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><span class="empty-icon">▧</span><strong>Aún no hay ventas</strong><p>Las operaciones de hoy aparecerán aquí.</p></div>{% endif %}</section>
{% endblock %}
</file>

<file path="dshalev/templates/distribution.html">
{% extends 'base.html' %}{% block title %}Fotos y APK{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">DISTRIBUCIÓN SPVI</p><h1>Fotos y actualización Android</h1><p class="muted">Publica activos para que las apps secundarias los reciban al sincronizar.</p></div></div>
<div class="content-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">FOTOS DEL CATÁLOGO</p><h2>Subir foto JPEG</h2></div><span class="icon-tile">▧</span></div><form id="photo-form" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Tipo de catálogo<select name="entity"><option value="producto">Producto</option><option value="servicio">Servicio móvil</option></select></label><label>ID del artículo<input name="entity_id" type="number" min="1" step="1" required></label><label>Imagen<input name="file" type="file" accept="image/jpeg,.jpg,.jpeg" required><small>JPEG, máximo 15 MiB. El vínculo se asigna por ID del artículo.</small></label><button class="primary-button" type="submit">Subir foto</button><p id="photo-status" class="tiny" role="status" aria-live="polite"></p></form></section>
<section class="panel"><div class="panel-heading"><div><p class="eyebrow">ACTUALIZACIÓN PARA SECUNDARIAS</p><h2>Publicar APK</h2></div><span class="icon-tile">⇧</span></div><p class="tiny">La app principal servirá el archivo por bloques cifrados SPVI y las secundarias comprobarán SHA-256. DShalev no firma ni verifica la firma de Android: publica solo APKs de una fuente confiable; Android exige que la actualización tenga una firma compatible al instalarse.</p><form id="apk-form" class="form-stack space-top"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Version code<input name="version_code" type="number" min="1" step="1" required></label><label>Archivo APK<input name="file" type="file" accept=".apk,application/vnd.android.package-archive" required><small>Máximo 300 MiB; debe contener AndroidManifest.xml.</small></label><button class="secondary-button" type="submit">Publicar APK</button><p id="apk-status" class="tiny" role="status" aria-live="polite"></p></form>{% if apk.apk_version_code %}<p class="tiny">APK publicada · version code {{ apk.apk_version_code }} · {{ apk.apk_bytes }} bytes · SHA-256 {{ apk.apk_sha256 }}</p>{% else %}<p class="tiny">No hay APK publicada.</p>{% endif %}</section></div>
<section class="panel table-panel space-top"><div class="panel-heading"><div><p class="eyebrow">IMÁGENES PUBLICADAS</p><h2>{{ photos|length }} fotos</h2></div></div>{% if photos %}<div class="table-wrap"><table><thead><tr><th>Tipo</th><th>ID</th><th>Archivo</th><th class="numeric">Tamaño</th><th>SHA-256</th></tr></thead><tbody>{% for photo in photos %}<tr><td>{{ photo.entity }}</td><td>{{ photo.entity_id }}</td><td>{{ photo.filename }}</td><td class="numeric">{{ photo.byte_length }}</td><td><code>{{ photo.sha256 }}</code></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><strong>Sin fotos publicadas</strong><p>Las fotos se distribuyen cuando las secundarias sincronizan el catálogo.</p></div>{% endif %}</section>
<script src="/static/distribution.js" defer></script>
{% endblock %}
</file>

<file path="dshalev/templates/employees.html">
{% extends 'base.html' %}{% block title %}Equipo{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">PERSONAS Y ACCESO</p><h1>Equipo</h1><p class="muted">Administra hasta {{ limit }} plazas secundarias para las apps Shalev e IShalev.</p></div></div>
{% if user.role == 'admin' %}<p><a class="text-link" href="/distribucion">Opciones avanzadas de sincronización: fotos y actualización Android →</a></p>{% endif %}
{% if sync_error %}<div class="notice warning">{{ sync_error }} Revisa que el firewall permita DShalev y reinicia.</div>{% elif not sync_port %}<div class="notice info">Para vincular una app móvil, habilita <a href="/red">LAN o remoto</a> y reinicia DShalev. En modo local el servidor nativo permanece apagado.</div>{% else %}<div class="notice info">Servidor de sincronización SPVI v1 activo en el puerto {{ sync_port }}. Los QR son de un solo uso y caducan a los 10 minutos.</div>{% endif %}
<div class="content-grid inventory-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">NUEVA PLAZA</p><h2>Agregar empleado</h2></div><span class="icon-tile">♙</span></div>
<form method="post" action="/equipo/nueva" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Nombre<input name="name" required maxlength="60" placeholder="Nombre del empleado"></label><fieldset class="permission-list"><legend>Permisos iniciales</legend>{% for key,label in permissions.items() %}<label class="check-row"><input type="checkbox" name="perm_{{ key }}" value="on" {% if key in ['vender_productos','vender_servicios','exportar'] %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</fieldset><button class="primary-button full" type="submit">Crear plaza</button></form></section>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">PLAZAS SECUNDARIAS</p><h2>{{ employees|length }} de {{ limit }}</h2></div></div>{% if employees %}<div class="employee-list">{% for employee in employees %}<article class="employee-row employee-pairing"><div class="avatar">{{ employee.name[:1]|upper }}</div><div class="employee-info"><strong>{{ employee.name }}</strong><small>Plaza {{ employee.slot }} · {% if employee.active %}activa{% else %}desactivada{% endif %}{% if employee.last_seen %} · última conexión {{ employee.last_seen }}{% endif %}</small><span class="employee-state">{% if employee.linked_at %}Vinculada{% else %}Pendiente de vincular{% endif %}</span>
{% if employee.active %}<details class="permission-editor"><summary>Permisos de la app móvil</summary><form method="post" action="/equipo/{{ employee.id }}/permisos"><input type="hidden" name="csrf" value="{{ csrf }}">{% for key,label in permissions.items() %}<label class="check-row"><input type="checkbox" name="perm_{{ key }}" value="on" {% if key in employee.enabled_permissions %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}<button class="secondary-button" type="submit">Guardar permisos</button></form></details>{% endif %}
{% if employee.active and sync_port %}<div class="pairing-actions">{% if employee.pairing_token and employee.pairing_expires and employee.pairing_expires > now_ms %}<img class="pairing-qr" src="/equipo/{{ employee.id }}/qr.svg" alt="QR de vinculación de {{ employee.name }}"><p class="tiny">Escanéalo desde la app Shalev o IShalev mientras estás en una red accesible por las direcciones configuradas.</p>{% endif %}<form method="post" action="/equipo/{{ employee.id }}/vincular"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="secondary-button" type="submit">{% if employee.linked_at %}Volver a vincular{% else %}Generar QR de vinculación{% endif %}</button></form></div>{% endif %}<div class="pairing-actions"><form method="post" action="/equipo/{{ employee.id }}/retirar"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="quiet-button" type="submit">Retirar plaza y revocar</button></form></div>
</div></article>{% endfor %}</div>{% else %}<div class="empty-state"><span class="empty-icon">♙</span><strong>Aún no hay empleados</strong><p>Crea una plaza y genera un QR para emparejar su app secundaria.</p></div>{% endif %}</section></div>
<section class="panel table-panel space-top"><div class="panel-heading"><div><p class="eyebrow">RECIBIDOS POR SPVI</p><h2>Actividad móvil reciente</h2></div></div>{% if sync_activities %}<div class="table-wrap"><table><thead><tr><th>Recepción</th><th>Empleado</th><th>Tipo</th><th>Detalle</th></tr></thead><tbody>{% for activity in sync_activities %}<tr><td>{{ activity.received_at|replace('T',' ')|truncate(16, True, '') }}</td><td>{{ activity.employee_name }}</td><td>{{ activity.kind_label }}</td><td>{{ activity.summary }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><strong>Aún no hay sincronizaciones</strong><p>Los lotes recibidos aparecerán aquí.</p></div>{% endif %}</section>
<section class="panel table-panel space-top"><div class="panel-heading"><div><p class="eyebrow">ACCIONES DE TURNO</p><h2>Solicitudes de cierre móvil</h2></div></div>{% if close_requests %}<div class="employee-list">{% for request in close_requests %}<article class="employee-row"><div class="employee-info"><strong>{{ request.employee_name }}</strong><small>La app solicita autorización para cerrar su turno.</small></div><form method="post" action="/equipo/{{ request.employee_id }}/cierre" class="inline-form"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="secondary-button" name="decision" value="aprobar" type="submit">Aprobar cierre</button><button class="quiet-button" name="decision" value="rechazar" type="submit">Rechazar</button></form></article>{% endfor %}</div>{% else %}<div class="empty-state"><strong>Sin solicitudes pendientes</strong><p>Las solicitudes recibidas aparecerán aquí.</p></div>{% endif %}</section>
<section class="panel table-panel space-top"><div class="panel-heading"><div><p class="eyebrow">TURNOS Y ARQUEOS MÓVILES</p><h2>{{ mobile_shifts|length }} turnos recientes</h2></div></div>{% if mobile_shifts %}<div class="table-wrap"><table><thead><tr><th>Empleado</th><th>Turno</th><th>Fondo</th><th>Contado</th><th>Estado del arqueo</th></tr></thead><tbody>{% for shift in mobile_shifts %}<tr><td>{{ shift.employee_name }}</td><td>{{ shift.uuid[:8] }} · {% if shift.closed_ms %}cerrado{% else %}abierto{% endif %}</td><td class="numeric">{% if shift.opening_cash_cents is not none %}{{ shift.opening_cash_cents|cup }}{% else %}—{% endif %}</td><td class="numeric">{% if shift.counted_cash_cents is not none %}{{ shift.counted_cash_cents|cup }}{% else %}—{% endif %}</td><td>{% if shift.count_payload and shift.closed_ms %}{% if shift.count_payload.aprobadoEn %}<span class="stock-badge ok">Aprobado</span>{% else %}<form method="post" action="/equipo/{{ shift.employee_id }}/turnos/{{ shift.uuid }}/conteo/aprobar"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="secondary-button" type="submit">Aprobar conteo</button></form>{% endif %}{% else %}—{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><strong>Sin turnos móviles recibidos</strong><p>Los turnos se registran aquí después de sincronizarse.</p></div>{% endif %}</section>
<section class="panel table-panel space-top"><div class="panel-heading"><div><p class="eyebrow">MOVIMIENTOS DE CAJA MÓVILES</p><h2>{{ mobile_cash|length }} recibidos</h2></div></div>{% if mobile_cash %}<div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Empleado</th><th>Tipo</th><th>Motivo</th><th class="numeric">Importe</th></tr></thead><tbody>{% for movement in mobile_cash %}<tr><td>{{ movement.created_at_display }}</td><td>{{ movement.employee_name }}</td><td>{{ movement.movement_type }}</td><td>{{ movement.reason }}</td><td class="numeric">{{ movement.amount_cents|cup }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><strong>Sin movimientos móviles recibidos</strong><p>Las entradas y salidas aparecerán aquí al sincronizarse.</p></div>{% endif %}</section>
<div class="notice warning space-top"><strong>Seguridad:</strong> el QR contiene una credencial temporal; muéstralo solo al empleado. Para datos móviles configura un host accesible mediante VPN o ruta segura. Las acciones remotas se autentican y cifran por SPVI, pero el relay de Shalev todavía no está integrado en DShalev.</div>
{% endblock %}
</file>

<file path="dshalev/templates/inventory_edit.html">
{% extends 'base.html' %}{% block title %}Editar artículo{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">CATÁLOGO DEL NEGOCIO</p><h1>Editar artículo</h1><p class="muted">Actualiza el nombre, precio, tipo o existencias.</p></div><a class="secondary-button" href="/inventario">Volver</a></div>
<section class="panel"><form method="post" action="/inventario/{{ item.id }}/editar" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Nombre<input name="name" required maxlength="80" value="{{ item.name }}"></label><div class="form-row"><label>Tipo<select name="category"><option {% if item.category == 'Producto' %}selected{% endif %}>Producto</option><option {% if item.category == 'Insumo' %}selected{% endif %}>Insumo</option><option {% if item.category == 'Servicio' %}selected{% endif %}>Servicio</option></select></label><label>Unidad<input name="unit" required maxlength="20" value="{{ item.unit }}"></label></div><div class="form-row"><label>Precio de venta (CUP)<input name="sale_price" type="number" min="0" step="0.01" value="{{ '%.2f'|format(item.sale_price_cents / 100) }}" required></label><label>Costo (CUP)<input name="cost" type="number" min="0" step="0.01" value="{{ '%.2f'|format(item.cost_cents / 100) }}" required></label></div><div class="form-row"><label>Existencia<input name="stock" type="number" min="0" step="0.001" value="{{ item.stock|qty }}" required></label><label>Stock bajo<input name="low_stock" type="number" min="0" step="0.001" value="{{ item.low_stock|qty }}" required></label></div><label>Stock crítico<input name="critical_stock" type="number" min="0" step="0.001" value="{{ item.critical_stock|qty }}" required></label><button class="primary-button" type="submit">Guardar cambios</button></form></section>
{% endblock %}
</file>

<file path="dshalev/templates/inventory.html">
{% extends 'base.html' %}{% block title %}Inventario{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">CATÁLOGO DEL NEGOCIO</p><h1>Inventario</h1><p class="muted">Gestiona artículos, precios y existencias.</p></div><a class="quiet-button" href="/inventario.csv">CSV</a><a class="quiet-button" href="/inventario.xlsx">Excel</a></div>
<div class="content-grid inventory-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">ALTA RÁPIDA</p><h2>Nuevo artículo</h2></div><span class="icon-tile">＋</span></div>
  <form method="post" action="/inventario/nuevo" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}">
    <label>Nombre<input name="name" required maxlength="80" placeholder="Ej. Café molido"></label>
    <div class="form-row"><label>Categoría<select name="category"><option>Producto</option><option>Insumo</option><option>Servicio</option></select></label><label>Unidad<input name="unit" value="unidad" maxlength="20" required></label></div>
    <div class="form-row"><label>Precio de venta (CUP)<input name="sale_price" type="number" min="0" step="0.01" inputmode="decimal" value="0" required></label><label>Costo (CUP)<input name="cost" type="number" min="0" step="0.01" inputmode="decimal" value="0" required></label></div>
    <div class="form-row"><label>Existencia<input name="stock" type="number" min="0" step="0.001" value="0" required></label><label>Stock bajo<input name="low_stock" type="number" min="0" step="0.001" value="5" required></label></div>
    <label>Stock crítico<input name="critical_stock" type="number" min="0" step="0.001" value="1" required></label>
    <button class="primary-button full" type="submit">Guardar artículo</button>
  </form>
</section>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">EXISTENCIAS</p><h2>{{ items|length }} artículos</h2></div><form method="get" action="/inventario" class="search-form"><input name="q" value="{{ query }}" placeholder="Buscar artículo" aria-label="Buscar artículo"><button class="quiet-button" type="submit">Buscar</button></form></div>
{% if items %}<div class="table-wrap"><table><thead><tr><th>Artículo</th><th>Categoría</th><th class="numeric">Precio</th><th class="numeric">Stock</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>{% for item in items %}<tr><td><strong>{{ item.name }}</strong><small class="cell-sub">{{ item.unit }}</small></td><td>{{ item.category }}</td><td class="numeric">{{ item.sale_price_cents|cup }}</td><td class="numeric stock">{{ item.stock|qty }}</td><td>{% if item.category == 'Servicio' %}<span class="stock-badge ok">Disponible</span>{% elif item.stock <= item.critical_stock %}<span class="stock-badge critical">Crítico</span>{% elif item.stock <= item.low_stock %}<span class="stock-badge low">Bajo</span>{% else %}<span class="stock-badge ok">Disponible</span>{% endif %}</td><td><a class="text-link" href="/inventario/{{ item.id }}/editar">Editar</a><form method="post" action="/inventario/{{ item.id }}/eliminar" class="inline-form"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="quiet-button" type="submit">Retirar</button></form></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><span class="empty-icon">▦</span><strong>No encontramos artículos</strong><p>Prueba otra búsqueda o crea el primero.</p></div>{% endif %}</section></div>
{% endblock %}
</file>

<file path="dshalev/templates/license.html">
{% extends 'base.html' %}{% block title %}Licencia{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">ESTADO DE LA APLICACIÓN</p><h1>Licencia</h1><p class="muted">Información de la implementación de escritorio.</p></div></div>
<section class="panel"><div class="notice warning">La activación y verificación de licencias GL todavía no están implementadas en DShalev.</div><p>La prueba local de siete días que se envía actualmente a las secundarias no es una licencia comercial GL ni un sub-token firmado. Este panel no activa ni valida licencias.</p><p class="muted">No introduzcas claves de licencia aquí. La integración y las pruebas con GL siguen pendientes.</p></section>
{% endblock %}
</file>

<file path="dshalev/templates/login.html">
{% extends 'base.html' %}{% block title %}Acceso{% endblock %}{% block public_content %}<main class="auth-page"><section class="auth-card"><a class="brand auth-brand" href="/"><span class="brand-mark">S</span><span>DShalev<small>Escritorio</small></span></a><p class="eyebrow">PUNTO DE VENTA · INVENTARIO</p><h1>Bienvenido</h1><p class="muted">Inicia sesión para entrar al panel de tu negocio.</p>{% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}{% if notice %}<div class="notice success" role="status">{{ notice }}</div>{% endif %}<form method="post" action="/entrar" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Usuario<input name="username" autocomplete="username" required autofocus maxlength="40"></label><label>Contraseña<input name="password" type="password" autocomplete="current-password" required></label><button class="primary-button full" type="submit">Entrar</button></form><p class="tiny">Tus datos permanecen en este equipo.</p></section></main>{% endblock %}
</file>

<file path="dshalev/templates/network.html">
{% extends 'base.html' %}{% block title %}Acceso y red{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">PRIVACIDAD Y CONECTIVIDAD</p><h1>Acceso y red</h1><p class="muted">Elige cómo se accede al escritorio y a las apps secundarias.</p></div></div>
<div class="content-grid network-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">MODO CONFIGURADO</p><h2>{{ mode_description }}</h2></div><span class="icon-tile">⌁</span></div>
<form method="post" action="/red" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><fieldset class="mode-list"><legend>Al reiniciar DShalev</legend>
<label class="mode-option"><input type="radio" name="network_mode" value="local" {% if network_mode == 'local' %}checked{% endif %}><span><strong>Solo este equipo</strong><small>Accesible desde el navegador del PC. El listener nativo queda apagado.</small></span></label>
<label class="mode-option"><input type="radio" name="network_mode" value="lan" {% if network_mode == 'lan' %}checked{% endif %}><span><strong>Red local</strong><small>El escritorio web usa HTTP en la red de confianza; la sincronización nativa SPVI cifra sus mensajes.</small></span></label>
<label class="mode-option"><input type="radio" name="network_mode" value="remote" {% if network_mode == 'remote' %}checked{% endif %}><span><strong>VPN o acceso remoto</strong><small>El escritorio web exige HTTPS. Para llegar desde otra red configura una VPN o una ruta de red/firewall segura.</small></span></label></fieldset>
<div class="form-row"><label>Certificado TLS web (ruta local)<input name="tls_cert" value="{{ tls_cert }}" maxlength="240" placeholder="C:\\certificados\\dshalev.pem"></label><label>Clave privada TLS web<input name="tls_key" value="{{ tls_key }}" maxlength="240" placeholder="C:\\certificados\\dshalev.key"></label></div>
<label>Host para conexión remota de las apps (opcional)<input name="public_host" value="{{ public_host }}" maxlength="253" placeholder="shalev.ejemplo.com"><small>Solo host o dominio, sin https:// ni puerto. También se incluyen las direcciones LAN en el QR.</small></label>
<button class="primary-button" type="submit">Guardar modo</button></form><p class="tiny">El cambio se aplica al reiniciar. DShalev no configura el router, no abre puertos automáticamente y no establece túneles VPN.</p></section>
<aside class="panel side-panel"><p class="eyebrow">DIRECCIONES DISPONIBLES</p><h2>Acceso web</h2>{% if addresses %}<ul class="address-list">{% for address in addresses %}<li><code>{{ scheme }}://{{ address }}:{{ port }}</code></li>{% endfor %}</ul>{% else %}<p class="muted">No se detectaron direcciones de red locales.</p>{% endif %}<div class="notice warning compact-notice">En modo LAN usa una red de confianza. HTTP local no cifra el acceso al escritorio; usa HTTPS por VPN cuando salgas de esa red.</div><div class="notice info compact-notice"><strong>Apps Shalev/IShalev:</strong> {% if sync_port %}listener SPVI v1 activo en el puerto TCP {{ sync_port }}. Sus mensajes están cifrados de extremo a extremo.{% else %}el listener nativo no está activo; se habilita al reiniciar en modo LAN o remoto.{% endif %} Los datos móviles requieren VPN o una ruta directa segura y configurada (TCP al puerto mostrado en Equipo/QR); el relay de Shalev aún no está conectado.</div><div class="notice warning compact-notice">El HTTPS del navegador y el canal nativo de sincronización son rutas distintas. No expongas el escritorio web a Internet sin HTTPS ni publiques el puerto nativo sin una ruta de red controlada.</div></aside></div>
{% endblock %}
</file>

<file path="dshalev/templates/recipes.html">
{% extends 'base.html' %}{% block title %}Recetas{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">CONSUMO DE INSUMOS</p><h1>Recetas</h1><p class="muted">Define cuánto insumo consume cada unidad de producto vendido.</p></div><a class="secondary-button" href="/inventario">Gestionar catálogo</a></div>
<div class="content-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">AGREGAR O ACTUALIZAR</p><h2>Ingrediente por producto</h2></div><span class="icon-tile">◈</span></div>{% if products and ingredients %}<form method="post" action="/recetas/guardar" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Producto<select name="product_id" required>{% for product in products %}<option value="{{ product.id }}">{{ product.name }}</option>{% endfor %}</select></label><label>Insumo<select name="ingredient_id" required>{% for ingredient in ingredients %}<option value="{{ ingredient.id }}">{{ ingredient.name }} ({{ ingredient.unit }}, stock {{ ingredient.stock|qty }})</option>{% endfor %}</select></label><label>Cantidad consumida por unidad<input name="quantity" type="number" min="0.001" step="0.001" required></label><button class="primary-button" type="submit">Guardar ingrediente</button></form>{% else %}<div class="empty-state"><strong>Faltan productos o insumos</strong><p>Crea un Producto y al menos un Insumo en Inventario para definir recetas.</p></div>{% endif %}</section>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">RECETAS ACTIVAS</p><h2>{{ recipes|length }} componentes</h2></div></div>{% if recipes %}<div class="table-wrap"><table><thead><tr><th>Producto</th><th>Insumo</th><th class="numeric">Cantidad por unidad</th><th>Acción</th></tr></thead><tbody>{% for recipe in recipes %}<tr><td>{{ recipe.product_name }}</td><td>{{ recipe.ingredient_name }}</td><td class="numeric">{{ (recipe.quantity_milli / 1000)|qty }} {{ recipe.unit }}</td><td><form method="post" action="/recetas/{{ recipe.product_id }}/{{ recipe.ingredient_id }}/eliminar"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="quiet-button" type="submit">Quitar</button></form></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><strong>No hay componentes registrados</strong><p>Las ventas no descontarán insumos hasta que agregues recetas.</p></div>{% endif %}</section></div>
{% endblock %}
</file>

<file path="dshalev/templates/reports.html">
{% extends 'base.html' %}{% block title %}Reportes{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">VENTAS Y EXPORTACIÓN</p><h1>Reportes</h1><p class="muted">Consulta las ventas web y recibidas desde la aplicación móvil.</p></div></div>
<section class="panel report-filter"><form method="get" action="/reportes" class="form-row"><label>Desde<input type="date" name="desde" value="{{ start }}" required></label><label>Hasta<input type="date" name="hasta" value="{{ end }}" required></label><button class="primary-button" type="submit">Aplicar</button><a class="quiet-button" href="/reportes/ventas.csv?desde={{ start }}&amp;hasta={{ end }}">CSV de ventas</a><a class="quiet-button" href="/reportes/ventas.xlsx?desde={{ start }}&amp;hasta={{ end }}">Excel de ventas</a></form></section>
<div class="stats-grid"><article class="stat-card"><span>Ventas en el período</span><strong>{{ sales|length }}</strong><small>Escritorio y móvil</small></article><article class="stat-card"><span>Importe total</span><strong>{{ sales_total|cup }}</strong><small>{{ start }} — {{ end }}</small></article>{% for method, amount in payment_totals.items() %}<article class="stat-card"><span>{{ method|title }}</span><strong>{{ amount|cup }}</strong><small>Ventas por método de pago</small></article>{% endfor %}</div>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">DETALLE</p><h2>Transacciones</h2></div></div>{% if sales %}<div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Origen</th><th>Cliente</th><th>Detalle</th><th>Pago</th><th class="numeric">Total</th></tr></thead><tbody>{% for row in sales %}<tr><td>{{ row.fecha|replace('T',' ')|truncate(19, True, '') }}</td><td>{{ row.origen }}</td><td>{{ row.cliente or '—' }}</td><td>{{ row.descripcion }}</td><td>{{ row.pago }}</td><td class="numeric">{{ row.total_cents|cup }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><strong>Sin ventas en este período</strong><p>Elige otras fechas o registra una venta.</p></div>{% endif %}</section>
{% endblock %}
</file>

<file path="dshalev/templates/sales.html">
{% extends 'base.html' %}{% block title %}Ventas{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">PUNTO DE VENTA</p><h1>Ventas</h1><p class="muted">Registra ventas de varias líneas y consulta operaciones móviles.</p></div></div>
<div class="content-grid sales-grid"><section class="panel pos-panel">{% if shift %}<div class="panel-heading"><div><p class="eyebrow">NUEVA OPERACIÓN WEB</p><h2>Carrito de venta</h2></div><span class="icon-tile">＋</span></div>
<div id="pos-app" class="pos-workspace" hidden data-shift="{{ shift.id }}" data-user="{{ user.id }}" data-sale-saved="{% if request.query_params.get('notice') == 'sale_saved' %}1{% else %}0{% endif %}">
  <div class="pos-catalog">
    <label class="pos-label" for="pos-search">Buscar artículo</label>
    <div class="pos-search"><input id="pos-search" type="search" maxlength="80" autocomplete="off" placeholder="Nombre del producto o servicio" aria-describedby="pos-search-help"><kbd>F2</kbd></div>
    <p id="pos-search-help" class="tiny">Busca y agrega artículos sin perder el carrito. F2 vuelve a la búsqueda.</p>
    <p id="pos-results-status" class="pos-result-status" role="status" aria-live="polite"></p>
    <div id="pos-results" class="pos-results" aria-label="Resultados de artículos"></div>
  </div>
  <form id="pos-sale-form" method="post" action="/ventas/nueva" class="pos-cart">
    <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="pos_prices" value="{}">
    <div class="pos-cart-heading"><div><p class="eyebrow">VENTA ACTUAL</p><h3>Carrito</h3></div><button type="button" id="pos-clear" class="quiet-button">Vaciar</button></div>
    <p id="pos-empty" class="pos-empty">Agrega artículos desde la búsqueda.</p>
    <div id="pos-lines" class="pos-lines"></div>
    <div class="pos-total"><span>Total estimado</span><strong id="pos-total">0 CUP</strong></div>
    <p class="tiny">Si cambia un precio, deberás revisar el carrito. La existencia y el turno se comprueban al registrar; el carrito no reserva inventario.</p>
    <label class="pos-label">Cliente (opcional)<select name="customer_id"><option value="">Venta sin cliente</option>{% for customer in customers %}<option value="{{ customer.id }}">{{ customer.name }}</option>{% endfor %}</select></label>
    <label class="pos-label">Forma de pago<select name="payment_method"><option value="EFECTIVO">Efectivo</option><option value="TRANSFERENCIA">Transferencia</option></select></label>
    <p id="pos-error" class="pos-error" role="alert"></p>
    <button id="pos-submit" class="primary-button full" type="submit" disabled>Registrar venta</button>
  </form>
</div>
<div id="pos-fallback"><form method="get" action="/ventas" class="search-form space-bottom"><input name="q" value="{{ query }}" placeholder="Filtra artículos para vender" aria-label="Filtrar artículos"><button class="quiet-button" type="submit">Buscar</button></form>
{% if items %}<form method="post" action="/ventas/nueva" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="table-wrap"><table class="cart-table"><thead><tr><th>Artículo</th><th>Tipo</th><th class="numeric">Precio</th><th class="numeric">Existencia</th><th class="numeric">Cantidad</th></tr></thead><tbody>{% for item in items %}<tr><td><strong>{{ item.name }}</strong><small class="cell-sub">{{ item.unit }}</small></td><td>{{ item.category }}</td><td class="numeric">{{ item.sale_price_cents|cup }}</td><td class="numeric">{% if item.category == 'Servicio' %}—{% else %}{{ item.stock }}{% endif %}</td><td class="numeric"><input class="cart-quantity" name="quantity_{{ item.id }}" aria-label="Cantidad de {{ item.name }}" type="number" min="0" max="100000" step="1" value="0"></td></tr>{% endfor %}</tbody></table></div><label>Cliente (opcional)<select name="customer_id"><option value="">Venta sin cliente</option>{% for customer in customers %}<option value="{{ customer.id }}">{{ customer.name }}</option>{% endfor %}</select></label><label>Forma de pago<select name="payment_method"><option value="EFECTIVO">Efectivo</option><option value="TRANSFERENCIA">Transferencia</option></select></label><p class="tiny">Pon la cantidad deseada en una o varias filas; deja las demás en cero. Máximo 60 líneas por venta.</p><button class="primary-button full" type="submit">Registrar venta</button></form>{% else %}<div class="empty-state"><strong>No hay artículos para vender</strong><p>Busca otro nombre o agrega existencia en Inventario.</p></div>{% endif %}
</div>
<script src="/static/pos.js" defer></script>
{% else %}<div class="panel-heading"><div><p class="eyebrow">NUEVA OPERACIÓN WEB</p><h2>Sin turno abierto</h2></div></div><p class="muted">Abre un turno en Inicio para registrar ventas desde este escritorio. Las apps móviles vinculadas mantienen sus propios turnos.</p><a class="secondary-button space-top" href="/">Ir a abrir turno</a>{% endif %}</section>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">ACTIVIDAD RECIENTE</p><h2>{{ sales|length }} ventas</h2></div></div>{% if sales %}<div class="table-wrap"><table><thead><tr><th>Hora</th><th>Descripción</th><th>Pago</th><th class="numeric">Total</th><th>Estado / acción</th></tr></thead><tbody>{% for sale in sales %}<tr><td>{{ sale.created_at|replace('T',' ')|truncate(16, True, '') }}</td><td>{{ sale.summary }}{% if sale.customer_name %}<span class="cell-sub">Cliente: {{ sale.customer_name }}</span>{% endif %}{% if sale.origin %}<span class="cell-sub">{{ sale.origin }}</span>{% endif %}</td><td>{{ sale.payment_method|title }}</td><td class="numeric amount">{{ sale.total_cents|cup }}</td><td>{% if sale.cancelled %}<span class="stock-badge critical">Anulada</span><small class="cell-sub">{{ sale.cancellation_reason }}</small>{% elif sale.origin and sale.origin.startswith('App secundaria') and user.role == 'admin' %}<form method="post" action="/ventas/movil/{{ sale.uuid }}/anular" class="inline-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input name="reason" required minlength="3" maxlength="160" placeholder="Motivo de anulación" aria-label="Motivo para anular"><button class="quiet-button" type="submit">Anular</button></form>{% if sale.correctable %}<details><summary>Corregir venta</summary><form method="post" action="/ventas/movil/{{ sale.uuid }}/corregir" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}">{% for detail in sale.details %}<label>{{ detail.nombre }}<input name="quantity_{{ loop.index0 }}" type="number" min="0" max="100000" step="1" value="{{ detail.cantidad }}" required></label>{% endfor %}<label>Pago<select name="payment_method"><option value="EFECTIVO" {% if sale.payment_method == 'EFECTIVO' %}selected{% endif %}>Efectivo</option><option value="TRANSFERENCIA" {% if sale.payment_method == 'TRANSFERENCIA' %}selected{% endif %}>Transferencia</option></select></label><label>Motivo<input name="reason" required minlength="3" maxlength="160"></label><button class="secondary-button" type="submit">Enviar corrección</button></form></details>{% endif %}{% else %}—{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><span class="empty-icon">▧</span><strong>Sin ventas recientes</strong><p>Las operaciones aparecerán aquí.</p></div>{% endif %}</section></div>
{% endblock %}
</file>

<file path="dshalev/templates/services.html">
{% extends 'base.html' %}{% block title %}Servicios{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">CATÁLOGO DEL NEGOCIO</p><h1>Servicios</h1><p class="muted">Crea servicios para vender desde este escritorio y asigna insumos en Recetas.</p></div><a class="secondary-button" href="/recetas">Gestionar recetas</a></div>
<div class="content-grid inventory-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">NUEVO SERVICIO</p><h2>Agregar servicio</h2></div></div>
<form method="post" action="/inventario/nuevo" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="origen" value="servicios"><input type="hidden" name="category" value="Servicio"><input type="hidden" name="unit" value="servicio"><input type="hidden" name="stock" value="0"><input type="hidden" name="low_stock" value="0"><input type="hidden" name="critical_stock" value="0">
<label>Nombre<input name="name" maxlength="80" required></label><label>Precio (CUP)<input name="sale_price" type="number" min="0" step="0.01" value="0" required></label><label>Costo (CUP)<input name="cost" type="number" min="0" step="0.01" value="0" required></label><button class="primary-button" type="submit">Guardar servicio</button></form></section>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">CATÁLOGO</p><h2>Servicios disponibles</h2></div><form method="get" action="/servicios" class="search-form"><input name="q" value="{{ query }}" placeholder="Buscar servicio" aria-label="Buscar servicio"><button class="quiet-button">Buscar</button></form></div>
{% if items %}<div class="table-wrap"><table><thead><tr><th>Servicio</th><th class="numeric">Precio</th><th>Acción</th></tr></thead><tbody>{% for item in items %}<tr><td>{{ item.name }}</td><td class="numeric">{{ item.sale_price_cents|cup }}</td><td><a class="text-link" href="/inventario/{{ item.id }}/editar">Editar</a></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><strong>No hay servicios para mostrar</strong><p>Agrega uno o cambia la búsqueda.</p></div>{% endif %}</section></div>
<p class="tiny">Estos servicios pertenecen al catálogo web. Los servicios móviles sincronizados usan un catálogo separado; la equivalencia completa está pendiente.</p>
{% endblock %}
</file>

<file path="dshalev/templates/setup.html">
{% extends 'base.html' %}{% block title %}Configuración inicial{% endblock %}{% block public_content %}<main class="auth-page"><section class="auth-card setup-card"><a class="brand auth-brand" href="/"><span class="brand-mark">S</span><span>DShalev<small>Escritorio</small></span></a><p class="eyebrow">PRIMER INICIO</p><h1>Configura tu negocio</h1><p class="muted">Crea la cuenta administradora. La contraseña se almacena como verificador con salt; no se guarda en texto claro.</p>{% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}<form method="post" action="/configurar" class="form-stack"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Nombre del negocio<input name="business_name" required maxlength="80" value="Mi negocio"></label><label>Usuario administrador<input name="username" autocomplete="username" required maxlength="40" pattern="[A-Za-z0-9._-]+"></label><label>Contraseña<input name="password" type="password" autocomplete="new-password" minlength="12" required><small>Al menos 12 caracteres.</small></label><label>Repite la contraseña<input name="password_confirm" type="password" autocomplete="new-password" minlength="12" required></label><button class="primary-button full" type="submit">Crear negocio</button></form><p class="tiny">Al continuar se crea DShalevData junto al programa portable.</p></section></main>{% endblock %}
