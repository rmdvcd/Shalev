  <a href="/herramientas" class="nav-link {% if section == 'herramientas' %}active{% endif %}" {% if section == 'herramientas' %}aria-current="page"{% endif %}><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M 21.74 18.31 L 13.48 10.05 C 14.29 7.96 13.84 5.51 12.12 3.79 C 10.3 1.97 7.58 1.61 5.4 2.61 L 9.3 6.51 L 6.58 9.23 L 2.58 5.33 C 1.5 7.51 1.95 10.23 3.76 12.05 C 5.49 13.77 7.94 14.22 10.03 13.41 L 18.29 21.67 C 18.65 22.03 19.2 22.03 19.56 21.67 L 21.65 19.58 C 22.1 19.22 22.1 18.58 21.74 18.31 z"/></svg></span>Herramientas</a>
