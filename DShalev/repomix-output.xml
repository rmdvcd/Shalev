<file path="dshalev/templates/shifts.html">
{% extends 'base.html' %}{% block title %}Turnos{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">CAJA Y ARQUEOS</p><h1>Turnos</h1><p class="muted">Aperturas, ventas en efectivo, movimientos y diferencias de cierre.</p></div><a class="primary-button" href="/">Volver a Inicio</a></div>
<section class="panel table-panel">{% if shifts %}<div class="table-wrap"><table><thead><tr><th>Turno</th><th>Apertura</th><th>Cierre</th><th class="numeric">Fondo</th><th class="numeric">Ventas</th><th class="numeric">Efectivo esperado</th><th class="numeric">Contado</th><th class="numeric">Diferencia</th></tr></thead><tbody>{% for shift in shifts %}<tr><td>#{{ shift.id }}{% if not shift.closed_at %}<span class="stock-badge ok">Abierto</span>{% endif %}</td><td>{{ shift.opened_at|replace('T',' ')|truncate(16, True, '') }}</td><td>{% if shift.closed_at %}{{ shift.closed_at|replace('T',' ')|truncate(16, True, '') }}{% else %}—{% endif %}</td><td class="numeric">{{ shift.opening_cash_cents|cup }}</td><td class="numeric">{{ shift.sales_total|cup }}</td><td class="numeric">{{ shift.expected_cash_cents|cup }}</td><td class="numeric">{% if shift.counted_cash_cents is not none %}{{ shift.counted_cash_cents|cup }}{% else %}—{% endif %}</td><td class="numeric">{% if shift.difference_cents is not none %}<strong class="{% if shift.difference_cents == 0 %}metric-state good{% else %}metric-state warning{% endif %}">{{ shift.difference_cents|cup }}</strong>{% else %}—{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><strong>Aún no hay turnos</strong><p>Al abrir un turno aparecerá aquí su resumen de caja.</p></div>{% endif %}</section>
{% endblock %}
</file>

<file path="dshalev/templates/tools.html">
{% extends 'base.html' %}{% block title %}Herramientas{% endblock %}{% block content %}
<div class="page-heading"><div><p class="eyebrow">HERRAMIENTAS DEL NEGOCIO</p><h1>Herramientas</h1><p class="muted">Cálculos independientes de las ventas y el inventario.</p></div></div>
<div class="content-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">CUP Y USD</p><h2>Calculadora de cambio</h2></div></div><p class="muted">La tasa es manual: cuántos CUP equivalen a un USD. No se consultan tasas en internet.</p>
<form method="post" action="/herramientas" class="form-stack space-top"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="modo" value="convertir"><input type="hidden" name="calcular" value="1"><label>Moneda de origen<select name="origen"><option value="USD" {% if origin == 'USD' %}selected{% endif %}>USD a CUP</option><option value="CUP" {% if origin == 'CUP' %}selected{% endif %}>CUP a USD</option></select></label><label>Importe<input name="importe" inputmode="decimal" value="{{ values.get('importe', '') }}" required></label><label>Tasa: CUP por USD<input name="tasa" inputmode="decimal" value="{{ values.get('tasa', '') }}" required></label><button class="primary-button">Convertir</button></form></section>
<section class="panel"><div class="panel-heading"><div><p class="eyebrow">CUP POR USD</p><h2>Calcular tasa</h2></div></div><p class="muted">Calcula una tasa orientativa a partir de dos importes positivos.</p><form method="post" action="/herramientas" class="form-stack space-top"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="modo" value="tasa"><input type="hidden" name="calcular" value="1"><label>Importe en CUP<input name="cup" inputmode="decimal" value="{{ values.get('cup', '') }}" required></label><label>Importe en USD<input name="usd" inputmode="decimal" value="{{ values.get('usd', '') }}" required></label><button class="secondary-button">Calcular tasa</button></form></section></div>
{% if error %}<div class="notice error" role="alert">{{ error }}</div>{% elif result %}<div class="notice success" role="status">Resultado: <strong>{{ result }}</strong></div>{% endif %}
<section class="panel"><h2>Fichas de costo</h2><p class="muted">Crea fichas con partidas, monedas y margen para estimar costos y precios.</p><a class="secondary-button space-top" href="/herramientas/fichas">Abrir fichas de costo</a></section>
{% endblock %}
</file>

