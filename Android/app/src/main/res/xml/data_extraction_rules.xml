<?xml version="1.0" encoding="utf-8"?>
<!-- Sin copia automática en la nube ni transferencia D2D: la clave del dispositivo no es transferible
     y restaurar datos de licencia en otro equipo solo produciría estados inválidos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
